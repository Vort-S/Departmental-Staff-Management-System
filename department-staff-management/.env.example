# Put real secrets in .env.local (never commit). Create separate sets on each Vercel environment.
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USERNAME:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require
SESSION_SECRET=GENERATE_BASE64_32_PLUS_RANDOM_BYTES
FIELD_ENCRYPTION_KEY=GENERATE_BASE64_32_RANDOM_BYTES
APP_URL=http://localhost:3000
# Resend email provider. Production deployment requires these.
RESEND_API_KEY=
MAIL_FROM=Department <noreply@your-verified-domain.example>
# Restrict external media/document links. Comma-separated HTTPS hostnames.
ALLOWED_URL_HOSTS=example.edu,drive.google.com,docs.google.com
# Seed only: use env (never included in demo records)
SEED_ADMIN_PASSWORD=
SEED_HOD_PASSWORD=
SEED_STAFF_PASSWORD=
# CI: isolated TEST branch only
TEST_DATABASE_URL=
